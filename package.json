{
  "name": "boar",
  "productName": "Boar",
  "version": "0.3.1",
  "private": true,
  "description": "Desktop video editor with a multitrack timeline and local AI tools.",
  "author": "Matteo Filosa",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "smoke": "electron-vite build && electron . --smoke",
    "samples": "node scripts/make-samples.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/tiktok-sans": "^5.3.0",
    "@fontsource-variable/tilt-neon": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.50.0",
